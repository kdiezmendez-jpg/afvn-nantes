{
  "name": "afvn-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-afvn --only firestore \"node tests/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "test:functions": "firebase emulators:exec --project demo-afvn --only firestore \"node tests/functions.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
